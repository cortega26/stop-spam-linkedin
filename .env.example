# stop-spam-linkedin store-submission environment template (plan 002).
# Copy to `.env` and fill in real values. Never commit `.env`.
# Key set covers `process.env.*` references in `scripts/submit-stores.js`
# and `tests/verify-amo-listing.js` (names only, no live values).
CHROME_EXTENSION_ID=your-chrome-extension-id
CHROME_PUBLISHER_ID=your-chrome-publisher-id
CHROME_CLIENT_ID=your-chrome-oauth-client-id
CHROME_CLIENT_SECRET=your-chrome-oauth-client-secret
CHROME_REFRESH_TOKEN=your-chrome-oauth-refresh-token
FIREFOX_API_KEY=your-firefox-api-key
FIREFOX_API_SECRET=your-firefox-api-secret
DRY_RUN=true
