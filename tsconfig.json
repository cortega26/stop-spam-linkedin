{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["es2022", "dom", "dom.iterable", "webworker.importscripts"],
    "types": ["chrome"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["content.js", "background.js", "popup/popup.js", "options/options.js", "i18n.js", "shared/**/*.js", "types/globals.d.ts"]
}
